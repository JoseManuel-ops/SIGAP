# Copiar a .env y reemplazar por los valores reales. Todos estos son simulados.

# Base de datos Supabase (pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.proyecto-simulado:clave-simulada@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth
SUPABASE_URL=https://proyecto-simulado.supabase.co
SUPABASE_ANON_KEY=llave-anon-simulada
VITE_SUPABASE_URL=https://proyecto-simulado.supabase.co
VITE_SUPABASE_ANON_KEY=llave-anon-simulada

# Factus Pay (sandbox)
FACTUS_PAY_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_TOKEN=token-simulado
FACTUS_WEBHOOK_KEY=llave-webhook-simulada

# Factus Facturación (sandbox)
FACTUS_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=client-id-simulado
FACTUS_CLIENT_SECRET=client-secret-simulado
FACTUS_USERNAME=usuario@ejemplo.com
FACTUS_PASSWORD=clave-simulada
